<div class="row mb-4 align-items-center">
    <div class="col-md-6">
        <h2 class="fw-bold mb-1">Study Groups</h2>
        <p class="text-muted small mb-0">Collaborate with classmates in subject-focused study groups</p>
    </div>
</div>

<div class="row g-4">
    <% if (groups && groups.length > 0) { %>
        <% groups.forEach(group => { %>
            <div class="col-md-6 col-lg-4">
                <div class="card card-custom p-4 h-100">
                    <div class="icon-tile icon-tile-gradient mb-3">
                        <i class="bi bi-people"></i>
                    </div>
                    <h5 class="fw-bold mb-2"><%= group.name %></h5>
                    <p class="text-muted small mb-3 flex-grow-1"><%= group.description %></p>
                    <div class="d-flex justify-content-between align-items-center border-top pt-3">
                        <span class="small text-muted"><i class="bi bi-person me-1"></i> <%= group.members.length %> Members</span>
                        <a href="/groups/<%= group._id %>" class="btn btn-sm btn-soft">View Group</a>
                    </div>
                </div>
            </div>
        <% }) %>
    <% } %>
</div>
