<div class="row justify-content-center align-items-center min-vh-75">
    <div class="col-md-5 col-lg-4">
        <div class="card card-custom p-4 shadow-lg text-center">
            <div class="icon-tile icon-tile-gradient rounded-circle mx-auto mb-3" style="width: 54px; height: 54px; font-size: 1.5rem;">
                <i class="bi bi-key"></i>
            </div>
            <h3 class="fw-bold mb-2">Forgot Password</h3>
            <p class="text-muted small mb-4">Enter your institutional email to receive a password reset token.</p>

            <form action="/auth/forgot" method="POST">
                <div class="form-floating mb-3">
                    <input type="email" name="email" class="form-control" id="floatingEmail" placeholder="name@campusconnect.edu" required>
                    <label for="floatingEmail">Institutional Email</label>
                </div>

                <button type="submit" class="btn btn-primary-gradient w-100 py-2 mb-3">
                    Generate Reset Link <i class="bi bi-send ms-1"></i>
                </button>
            </form>

            <a href="/auth/login" class="small text-muted text-decoration-none"><i class="bi bi-arrow-left"></i> Back to Login</a>
        </div>
    </div>
</div>
