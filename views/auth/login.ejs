<!-- Centered Sign In Page -->
<div class="d-flex align-items-center justify-content-center min-vh-80 py-4">
    <div class="bento-card spotlight-card p-4 p-sm-5 shadow-lg border-hairline w-100 mx-auto" style="max-width: 460px;">
        <!-- Header -->
        <div class="text-center mb-4">
            <div class="icon-tile icon-tile-gradient rounded-circle mx-auto mb-3" style="width: 56px; height: 56px; font-size: 1.4rem;">
                <i class="bi bi-person-lock"></i>
            </div>
            <h2 class="fw-extrabold font-heading mb-1">Sign In</h2>
            <p class="text-secondary-custom small mb-0">Enter your campus credentials to continue</p>
        </div>

        <!-- Login Form -->
        <form action="/auth/login" method="POST">
            <div class="form-floating mb-3">
                <input type="email" name="email" class="form-control" id="floatingEmail" placeholder="name@campusconnect.edu" required autocomplete="email">
                <label for="floatingEmail">Institutional Email</label>
            </div>

            <div class="form-floating mb-3 position-relative">
                <input type="password" name="password" class="form-control" id="floatingPassword" placeholder="Password" required autocomplete="current-password">
                <label for="floatingPassword">Password</label>
                <button type="button" class="btn btn-sm text-muted position-absolute end-0 top-50 translate-middle-y me-2 toggle-password" data-target="#floatingPassword" aria-label="Toggle Password Visibility">
                    <i class="bi bi-eye fs-6"></i>
                </button>
            </div>

            <div class="d-flex justify-content-between align-items-center mb-4">
                <div class="form-check mb-0">
                    <input type="checkbox" name="remember" class="form-check-input" id="rememberCheck">
                    <label class="form-check-label small text-secondary-custom" for="rememberCheck">Remember me</label>
                </div>
                <a href="/auth/forgot" class="small text-primary text-decoration-none fw-semibold">Forgot Password?</a>
            </div>

            <button type="submit" class="btn btn-aurora btn-shine w-100 py-3 justify-content-center mb-3">
                Sign In <i class="bi bi-arrow-right ms-1"></i>
            </button>
        </form>

        <!-- Footer link -->
        <div class="text-center mt-2 small text-secondary-custom">
            Don't have an account? <a href="/auth/signup" class="text-primary fw-bold text-decoration-none ms-1">Create Account</a>
        </div>
    </div>
</div>
