<!-- Split Layout Login Page -->
<div class="container py-4">
    <div class="row g-0 bento-card p-0 overflow-hidden shadow-lg border-hairline" style="min-height: 560px;">
        <!-- Left Side: Aurora Gradient & Floating Glass Cards -->
        <div class="col-lg-6 d-none d-lg-flex flex-column justify-content-between p-5 position-relative overflow-hidden" style="background: var(--aurora); border-right: 1px solid var(--line);">
            <div class="hero-grid-pattern"></div>
            
            <div class="position-relative" style="z-index: 2;">
                <a class="d-flex align-items-center gap-2 text-decoration-none mb-4" href="/">
                    <div class="icon-tile icon-tile-gradient rounded-circle" style="width: 40px; height: 40px; font-size: 1.1rem;">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                    <span class="fw-bold fs-4 text-gradient font-heading">Campus Connect</span>
                </a>
                <h2 class="display-6 fw-extrabold font-heading mb-2">Welcome Back to Campus</h2>
                <p class="text-secondary-custom">Access official announcements, upcoming event schedules, and shared study materials.</p>
            </div>

            <!-- Floating Glass Notice Cards Stack -->
            <div class="position-relative my-4" style="z-index: 2;">
                <div class="p-3 rounded-4 bg-surface shadow-sm border border-hairline mb-2" style="background: var(--surface-2);">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="badge badge-exam"><i class="bi bi-megaphone me-1"></i> Exam Notice</span>
                        <span class="small text-muted">2h ago</span>
                    </div>
                    <div class="fw-bold small text-truncate">Final Mid-Semester Schedules Released</div>
                </div>

                <div class="p-3 rounded-4 bg-surface shadow-sm border border-hairline opacity-90 ms-3" style="background: var(--surface-2);">
                    <div class="d-flex align-items-center justify-content-between mb-1">
                        <span class="badge badge-event"><i class="bi bi-calendar-event me-1"></i> Campus Event</span>
                        <span class="small text-muted">Tomorrow</span>
                    </div>
                    <div class="fw-bold small text-truncate">Annual AI Innovation Hackathon 2026</div>
                </div>
            </div>

            <div class="position-relative" style="z-index: 2;">
                <blockquote class="blockquote mb-0 small text-secondary-custom italic">
                    "Campus Connect helped our department coordinate tech fests and share verified lecture notes seamlessly."
                </blockquote>
                <div class="small fw-bold text-dark dark-text-light mt-1">— Student Council Executive</div>
            </div>
        </div>

        <!-- Right Side: Login Form -->
        <div class="col-lg-6 d-flex align-items-center justify-content-center p-4 p-md-5">
            <div class="w-100" style="max-width: 400px;">
                <div class="text-center mb-4">
                    <div class="icon-tile icon-tile-gradient rounded-circle mx-auto mb-3" style="width: 50px; height: 50px; font-size: 1.3rem;">
                        <i class="bi bi-person-lock"></i>
                    </div>
                    <h2 class="fw-extrabold font-heading">Sign In</h2>
                    <p class="text-secondary-custom small">Enter your campus credentials to continue</p>
                </div>

                <form action="/auth/login" method="POST">
                    <div class="form-floating mb-3">
                        <input type="email" name="email" class="form-control" id="floatingEmail" placeholder="name@campusconnect.edu" required>
                        <label for="floatingEmail">Institutional Email</label>
                    </div>

                    <div class="form-floating mb-3 position-relative">
                        <input type="password" name="password" class="form-control" id="floatingPassword" placeholder="Password" required>
                        <label for="floatingPassword">Password</label>
                        <button type="button" class="btn btn-sm text-muted position-absolute end-0 top-50 translate-middle-y me-2 toggle-password" data-target="#floatingPassword">
                            <i class="bi bi-eye"></i>
                        </button>
                    </div>

                    <div class="d-flex justify-content-between align-items-center mb-4">
                        <div class="form-check">
                            <input type="checkbox" name="remember" class="form-check-input" id="rememberCheck">
                            <label class="form-check-label small text-secondary-custom" for="rememberCheck">Remember me</label>
                        </div>
                        <a href="/auth/forgot" class="small text-primary text-decoration-none fw-semibold">Forgot Password?</a>
                    </div>

                    <button type="submit" class="btn btn-aurora btn-shine w-100 py-3 justify-content-center mb-3">
                        Sign In <i class="bi bi-arrow-right ms-1"></i>
                    </button>
                </form>

                <div class="text-center mt-3 small text-secondary-custom">
                    Don't have an account? <a href="/auth/signup" class="text-primary fw-bold text-decoration-none">Create Account</a>
                </div>
            </div>
        </div>
    </div>
</div>
