<!-- Split Layout Signup Page with 3-Step Interactive Stepper -->
<div class="container py-4">
    <div class="row g-0 bento-card p-0 overflow-hidden shadow-lg border-hairline" style="min-height: 600px;">
        <!-- Left Side Panel -->
        <div class="col-lg-5 d-none d-lg-flex flex-column justify-content-between p-5 position-relative overflow-hidden" style="background: var(--aurora); border-right: 1px solid var(--line);">
            <div class="hero-grid-pattern"></div>
            
            <div class="position-relative" style="z-index: 2;">
                <a class="d-flex align-items-center gap-2 text-decoration-none mb-4" href="/">
                    <div class="icon-tile icon-tile-gradient rounded-circle" style="width: 40px; height: 40px; font-size: 1.1rem;">
                        <i class="bi bi-mortarboard-fill"></i>
                    </div>
                    <span class="fw-bold fs-4 text-gradient font-heading">Campus Connect</span>
                </a>
                <h2 class="display-6 fw-extrabold font-heading mb-2">Create Student Account</h2>
                <p class="text-secondary-custom">Join over 1,500+ peers sharing lecture notes, official circulars, and event updates.</p>
            </div>

            <!-- Floating Preview Card -->
            <div class="position-relative my-4" style="z-index: 2;">
                <div class="p-3.5 rounded-4 bg-surface shadow-sm border border-hairline" style="background: var(--surface-2);">
                    <div class="d-flex align-items-center gap-3 mb-2">
                        <div class="avatar-pill">S</div>
                        <div>
                            <div class="fw-bold small">Verified Student Profile</div>
                            <div class="small text-muted">Engineering & Science Portal</div>
                        </div>
                    </div>
                    <p class="small text-secondary-custom mb-0">Get verified access to department-specific study hub files and official exam notifications.</p>
                </div>
            </div>

            <div class="position-relative" style="z-index: 2;">
                <div class="small text-secondary-custom">Step-by-step easy registration process.</div>
            </div>
        </div>

        <!-- Right Side: 3-Step Interactive Form -->
        <div class="col-lg-7 d-flex align-items-center justify-content-center p-4 p-md-5">
            <div class="w-100" style="max-width: 520px;">
                <!-- Step Indicator Header -->
                <div class="mb-4 text-center">
                    <h3 class="fw-extrabold font-heading mb-1">Student Registration</h3>
                    <p class="text-secondary-custom small">Complete 3 quick steps to get started</p>
                    
                    <!-- Progress Bar Header -->
                    <div class="position-relative my-4 px-3">
                        <div class="progress" style="height: 4px; background: var(--line);">
                            <div id="stepProgressLine" class="progress-bar bg-primary" style="width: 0%; transition: width 0.3s var(--ease);"></div>
                        </div>
                        <div class="d-flex justify-content-between position-absolute top-50 start-0 end-0 translate-middle-y px-3">
                            <span class="step-indicator-item active rounded-circle bg-primary text-white d-inline-flex align-items-center justify-content-center fw-bold small" style="width: 28px; height: 28px;">1</span>
                            <span class="step-indicator-item rounded-circle bg-secondary-subtle text-muted d-inline-flex align-items-center justify-content-center fw-bold small" style="width: 28px; height: 28px;">2</span>
                            <span class="step-indicator-item rounded-circle bg-secondary-subtle text-muted d-inline-flex align-items-center justify-content-center fw-bold small" style="width: 28px; height: 28px;">3</span>
                        </div>
                    </div>
                </div>

                <form action="/auth/signup" method="POST" id="signupFormStepper">
                    <!-- Step 1: Basic Info -->
                    <div class="form-step" data-step="0">
                        <h5 class="fw-bold font-heading mb-3"><i class="bi bi-person me-2 text-primary"></i> Step 1: Personal Details</h5>
                        <div class="form-floating mb-3">
                            <input type="text" name="name" class="form-control" id="floatingName" placeholder="Full Name" required>
                            <label for="floatingName">Full Name</label>
                        </div>
                        <div class="form-floating mb-3">
                            <input type="email" name="email" class="form-control" id="floatingEmail" placeholder="name@campusconnect.edu" required>
                            <label for="floatingEmail">Institutional Email</label>
                        </div>
                    </div>

                    <!-- Step 2: Academic Details -->
                    <div class="form-step d-none" data-step="1">
                        <h5 class="fw-bold font-heading mb-3"><i class="bi bi-book me-2 text-primary"></i> Step 2: Academic Info</h5>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select name="course" class="form-select" id="floatingCourse" required>
                                        <option value="">Select Course</option>
                                        <option value="B.Tech">B.Tech</option>
                                        <option value="M.Tech">M.Tech</option>
                                        <option value="BCA">BCA</option>
                                        <option value="MCA">MCA</option>
                                        <option value="B.Sc">B.Sc</option>
                                        <option value="MBA">MBA</option>
                                    </select>
                                    <label for="floatingCourse">Course</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select name="department" class="form-select" id="floatingDept" required>
                                        <option value="">Select Department</option>
                                        <option value="Computer Science">Computer Science</option>
                                        <option value="Information Technology">Information Technology</option>
                                        <option value="Electronics">Electronics</option>
                                        <option value="Mechanical">Mechanical</option>
                                        <option value="Business Admin">Business Admin</option>
                                    </select>
                                    <label for="floatingDept">Department</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select name="year" class="form-select" id="floatingYear">
                                        <option value="1">Year 1</option>
                                        <option value="2">Year 2</option>
                                        <option value="3">Year 3</option>
                                        <option value="4">Year 4</option>
                                    </select>
                                    <label for="floatingYear">Academic Year</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating">
                                    <select name="semester" class="form-select" id="floatingSem">
                                        <option value="1">Semester 1</option>
                                        <option value="2">Semester 2</option>
                                        <option value="3">Semester 3</option>
                                        <option value="4">Semester 4</option>
                                        <option value="5">Semester 5</option>
                                        <option value="6">Semester 6</option>
                                    </select>
                                    <label for="floatingSem">Semester</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Step 3: Security & Bio -->
                    <div class="form-step d-none" data-step="2">
                        <h5 class="fw-bold font-heading mb-3"><i class="bi bi-shield-lock me-2 text-primary"></i> Step 3: Password & Security</h5>
                        <div class="row g-3 mb-3">
                            <div class="col-md-6">
                                <div class="form-floating position-relative">
                                    <input type="password" name="password" class="form-control" id="passwordInput" placeholder="Password" required>
                                    <label for="passwordInput">Password</label>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-floating position-relative">
                                    <input type="password" name="confirmPassword" class="form-control" id="floatingConfirmPassword" placeholder="Confirm Password" required>
                                    <label for="floatingConfirmPassword">Confirm Password</label>
                                </div>
                            </div>
                            <div class="col-12">
                                <!-- Password Strength Meter -->
                                <div class="d-flex justify-content-between align-items-center small mb-1">
                                    <span class="text-muted">Password Strength:</span>
                                    <span id="passwordStrengthText" class="fw-bold text-primary"></span>
                                </div>
                                <div class="progress mb-3" style="height: 6px; background: var(--line);">
                                    <div id="passwordStrengthMeter" class="progress-bar" role="progressbar" style="width: 0%;"></div>
                                </div>
                            </div>
                            <div class="col-12">
                                <div class="form-floating">
                                    <textarea name="bio" class="form-control" id="floatingBio" style="height: 80px;" placeholder="Bio"></textarea>
                                    <label for="floatingBio">Short Bio (Optional)</label>
                                </div>
                            </div>
                        </div>
                    </div>

                    <!-- Navigation Controls -->
                    <div class="d-flex align-items-center justify-content-between mt-4">
                        <button type="button" id="stepPrevBtn" class="btn btn-aurora-secondary rounded-pill px-4 d-none">
                            <i class="bi bi-arrow-left me-1"></i> Back
                        </button>
                        <button type="button" id="stepNextBtn" class="btn btn-aurora btn-shine rounded-pill px-4 ms-auto">
                            Next Step <i class="bi bi-arrow-right ms-1"></i>
                        </button>
                        <button type="submit" id="stepSubmitBtn" class="btn btn-aurora btn-shine rounded-pill px-4 ms-auto d-none">
                            Create Account <i class="bi bi-check-circle ms-1"></i>
                        </button>
                    </div>
                </form>

                <div class="text-center mt-4 small text-secondary-custom">
                    Already registered? <a href="/auth/login" class="text-primary fw-bold text-decoration-none">Sign In</a>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="/js/modules/stepper.js"></script>
