<%- include('head') %>
<%- include('navbar') %>

<% if (typeof siteBanner !== 'undefined' && siteBanner) { %>
    <div class="alert alert-<%= siteBanner.type || 'info' %> alert-dismissible text-center mb-0 rounded-0 border-0 py-2">
        <i class="bi bi-bell-fill me-1"></i> <%= siteBanner.text %>
        <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
    </div>
<% } %>

<main class="min-vh-100 py-4">
    <div class="container-fluid px-lg-4">
        <%- include('flash') %>
        <%- body %>
    </div>
</main>

<%- include('footer') %>
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
<script src="/js/main.js"></script>
</body>
</html>
