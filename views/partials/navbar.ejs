<!-- Announcement Bar (Slim 36px, Soft blue tint, Dismissible) -->
<% if (typeof siteBanner !== 'undefined' && siteBanner) { %>
    <div id="siteAnnouncementBar" class="announcement-bar">
        <div class="container d-flex align-items-center justify-content-center position-relative">
            <span class="d-flex align-items-center gap-2">
                <i class="bi bi-bell-fill"></i> <%= siteBanner.text %>
            </span>
            <button type="button" id="dismissAnnouncement" class="btn-close btn-close-white position-absolute end-0 me-3 opacity-75" style="font-size: 0.7rem;" aria-label="Dismiss"></button>
        </div>
    </div>
<% } %>

<!-- Floating Glass Navbar Container -->
<div class="navbar-wrapper">
    <nav class="navbar navbar-expand-lg navbar-glass">
        <div class="container-fluid px-1">
            <!-- Brand Logo -->
            <a class="navbar-brand d-flex align-items-center gap-2 me-lg-4" href="/">
                <div class="icon-tile icon-tile-gradient rounded-circle" style="width: 36px; height: 36px; font-size: 1rem;">
                    <i class="bi bi-mortarboard-fill"></i>
                </div>
                <span class="fw-bold fs-5 text-gradient font-heading">Campus Connect</span>
            </a>

            <!-- Mobile Hamburger Toggle -->
            <button class="navbar-toggler border-0 p-1" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
                <i class="bi bi-list fs-2 text-primary"></i>
            </button>

            <!-- Collapsible Links -->
            <div class="collapse navbar-collapse" id="navbarMain">
                <div class="navbar-nav-container mx-auto my-2 my-lg-0">
                    <% if (user) { %>
                        <a class="nav-link-aurora" href="/dashboard"><i class="bi bi-grid-1x2 me-1"></i> Dashboard</a>
                        <a class="nav-link-aurora" href="/notices"><i class="bi bi-megaphone me-1"></i> Notices</a>
                        <a class="nav-link-aurora" href="/events"><i class="bi bi-calendar-event me-1"></i> Events</a>
                        <a class="nav-link-aurora" href="/resources"><i class="bi bi-folder2-open me-1"></i> Study Hub</a>
                        <a class="nav-link-aurora" href="/community"><i class="bi bi-chat-square-text me-1"></i> Community</a>
                        
                        <!-- More Dropdown for secondary pages -->
                        <div class="dropdown d-inline-block">
                            <a class="nav-link-aurora dropdown-toggle" href="#" data-bs-toggle="dropdown">
                                <i class="bi bi-three-dots me-1"></i> More
                            </a>
                            <ul class="dropdown-menu shadow-lg border-0 rounded-4 p-2 mt-2">
                                <li><a class="dropdown-item rounded-3 py-2" href="/groups"><i class="bi bi-people me-2 text-indigo"></i> Study Groups</a></li>
                                <li><a class="dropdown-item rounded-3 py-2" href="/about"><i class="bi bi-info-circle me-2 text-cyan"></i> About Platform</a></li>
                                <li><a class="dropdown-item rounded-3 py-2" href="/contact"><i class="bi bi-envelope me-2 text-warning"></i> Contact Support</a></li>
                            </ul>
                        </div>
                    <% } else { %>
                        <a class="nav-link-aurora" href="/">Home</a>
                        <a class="nav-link-aurora" href="/notices">Notices</a>
                        <a class="nav-link-aurora" href="/events">Events</a>
                        <a class="nav-link-aurora" href="/about">About</a>
                        <a class="nav-link-aurora" href="/contact">Contact</a>
                    <% } %>
                </div>

                <!-- Right Side Actions -->
                <div class="d-flex align-items-center gap-2 ms-auto mt-2 mt-lg-0">
                    <% if (user) { %>
                        <!-- Command Palette Trigger Button -->
                        <button type="button" class="search-trigger-btn" id="searchTrigger" title="Search (Ctrl+K or /)">
                            <i class="bi bi-search"></i>
                            <span class="d-none d-xl-inline me-1">Search...</span>
                            <span class="kbd-badge">Ctrl K</span>
                        </button>

                        <!-- Theme Switcher Button -->
                        <button type="button" class="btn-theme-toggle" onclick="toggleTheme()" title="Toggle Dark/Light Mode">
                            <i class="bi bi-sun-fill d-none-dark"></i>
                            <i class="bi bi-moon-stars-fill d-none-light"></i>
                        </button>

                        <!-- Notification Dropdown Preview -->
                        <div class="dropdown">
                            <button class="btn btn-theme-toggle position-relative border-0" data-bs-toggle="dropdown" aria-label="Notifications">
                                <i class="bi bi-bell"></i>
                                <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
                                    <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger rounded-circle border border-white">
                                        <span class="urgent-pulse"></span>
                                    </span>
                                <% } %>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-2 rounded-4 mt-2" style="width: 300px;">
                                <li class="d-flex justify-content-between align-items-center px-3 py-2">
                                    <span class="fw-bold">Notifications</span>
                                    <a href="/notifications" class="small text-primary text-decoration-none">View All</a>
                                </li>
                                <li><hr class="dropdown-divider"></li>
                                <li class="text-center py-3 text-muted small">
                                    <i class="bi bi-bell-fill fs-4 text-primary d-block mb-1"></i>
                                    Check <a href="/notifications" class="fw-semibold text-primary">Notification Center</a> for detailed updates
                                </li>
                            </ul>
                        </div>

                        <!-- User Profile Dropdown -->
                        <div class="dropdown ms-1">
                            <button class="btn p-0 border-0" data-bs-toggle="dropdown" aria-label="User Profile">
                                <div class="avatar-pill">
                                    <%= user.name ? user.name.charAt(0).toUpperCase() : 'U' %>
                                </div>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-2 rounded-4 mt-2" style="width: 230px;">
                                <li class="px-3 py-2 border-bottom mb-1">
                                    <div class="fw-bold text-truncate"><%= user.name %></div>
                                    <div class="small text-muted text-capitalize"><%= user.role %> Account</div>
                                </li>
                                <% if (user.role === 'admin') { %>
                                    <li><a class="dropdown-item rounded-3 py-2 text-danger fw-bold" href="/admin"><i class="bi bi-shield-lock me-2"></i> Admin Panel</a></li>
                                    <li><hr class="dropdown-divider"></li>
                                <% } %>
                                <li><a class="dropdown-item rounded-3 py-2" href="/profile"><i class="bi bi-person me-2 text-primary"></i> My Profile</a></li>
                                <li><a class="dropdown-item rounded-3 py-2" href="/profile#bookmarks"><i class="bi bi-bookmark me-2 text-warning"></i> Saved Bookmarks</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item rounded-3 py-2 text-danger" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i> Sign Out</a></li>
                            </ul>
                        </div>
                    <% } else { %>
                        <!-- Theme Toggle for Guests -->
                        <button type="button" class="btn-theme-toggle me-2" onclick="toggleTheme()" title="Toggle Dark/Light Mode">
                            <i class="bi bi-sun-fill d-none-dark"></i>
                            <i class="bi bi-moon-stars-fill d-none-light"></i>
                        </button>
                        <a href="/auth/login" class="btn btn-aurora-soft px-3 py-2">Sign In</a>
                        <a href="/auth/signup" class="btn btn-aurora px-4 py-2">Get Started</a>
                    <% } %>
                </div>
            </div>
        </div>
    </nav>
</div>
