<nav class="navbar navbar-expand-lg navbar-glass sticky-top py-2">
    <div class="container-fluid px-lg-4">
        <a class="navbar-brand d-flex align-items-center gap-2" href="/">
            <div class="icon-tile icon-tile-gradient rounded-circle" style="width: 38px; height: 38px; font-size: 1.1rem;">
                <i class="bi bi-mortarboard-fill"></i>
            </div>
            <span class="fw-bold fs-4 text-gradient">Campus Connect</span>
        </a>

        <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#navbarMain">
            <i class="bi bi-list fs-2 text-primary"></i>
        </button>

        <div class="collapse navbar-collapse" id="navbarMain">
            <ul class="navbar-nav mx-auto mb-2 mb-lg-0 gap-lg-2">
                <% if (user) { %>
                    <li class="nav-item"><a class="nav-link" href="/dashboard"><i class="bi bi-grid-1x2 me-1"></i> Dashboard</a></li>
                    <li class="nav-item"><a class="nav-link" href="/notices"><i class="bi bi-megaphone me-1"></i> Notices</a></li>
                    <li class="nav-item"><a class="nav-link" href="/events"><i class="bi bi-calendar-event me-1"></i> Events</a></li>
                    <li class="nav-item"><a class="nav-link" href="/resources"><i class="bi bi-folder2-open me-1"></i> Study Hub</a></li>
                    <li class="nav-item"><a class="nav-link" href="/community"><i class="bi bi-chat-square-text me-1"></i> Community</a></li>
                    <li class="nav-item"><a class="nav-link" href="/groups"><i class="bi bi-people me-1"></i> Groups</a></li>
                <% } else { %>
                    <li class="nav-item"><a class="nav-link" href="/">Home</a></li>
                    <li class="nav-item"><a class="nav-link" href="/about">About</a></li>
                    <li class="nav-item"><a class="nav-link" href="/contact">Contact</a></li>
                <% } %>
            </ul>

            <div class="d-flex align-items-center gap-3">
                <% if (user) { %>
                    <!-- Search Icon Trigger -->
                    <button class="btn btn-light rounded-circle shadow-sm" id="searchTrigger" title="Search (Press /)">
                        <i class="bi bi-search text-muted"></i>
                    </button>

                    <!-- Notifications Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-light rounded-circle shadow-sm position-relative" data-bs-toggle="dropdown">
                            <i class="bi bi-bell text-muted"></i>
                            <% if (typeof unreadCount !== 'undefined' && unreadCount > 0) { %>
                                <span class="position-absolute top-0 start-100 translate-middle p-1 bg-danger border border-light rounded-circle">
                                    <span class="visually-hidden">New alerts</span>
                                </span>
                            <% } %>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-2" style="width: 280px;">
                            <li class="d-flex justify-content-between align-items-center px-2 py-1">
                                <span class="fw-bold">Notifications</span>
                                <a href="/notifications" class="small text-primary text-decoration-none">View all</a>
                            </li>
                            <li><hr class="dropdown-divider"></li>
                            <li class="text-center py-3 text-muted small">
                                Check <a href="/notifications">notifications center</a>
                            </li>
                        </ul>
                    </div>

                    <!-- User Profile Dropdown -->
                    <div class="dropdown">
                        <button class="btn p-0 border-0" data-bs-toggle="dropdown">
                            <div class="avatar-initials">
                                <%= user.name.charAt(0).toUpperCase() %>
                            </div>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end shadow-lg border-0 p-2" style="width: 220px;">
                            <li class="px-3 py-2 border-bottom mb-1">
                                <div class="fw-bold text-truncate"><%= user.name %></div>
                                <div class="small text-muted text-capitalize"><%= user.role %></div>
                            </li>
                            <% if (user.role === 'admin') { %>
                                <li><a class="dropdown-item rounded-2 py-2 text-danger fw-bold" href="/admin"><i class="bi bi-shield-lock me-2"></i> Admin Panel</a></li>
                            <% } %>
                            <li><a class="dropdown-item rounded-2 py-2" href="/profile"><i class="bi bi-person me-2"></i> My Profile</a></li>
                            <li><a class="dropdown-item rounded-2 py-2" href="/profile#bookmarks"><i class="bi bi-bookmark me-2"></i> Bookmarks</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li><a class="dropdown-item rounded-2 py-2 text-danger" href="/auth/logout"><i class="bi bi-box-arrow-right me-2"></i> Sign Out</a></li>
                        </ul>
                    </div>
                <% } else { %>
                    <a href="/auth/login" class="btn btn-soft px-4 py-2">Sign In</a>
                    <a href="/auth/signup" class="btn btn-primary-gradient px-4 py-2">Get Started</a>
                <% } %>
            </div>
        </div>
    </div>
</nav>

<!-- Global Live Search Overlay -->
<div id="searchOverlay" class="position-fixed top-0 start-0 w-100 h-100 bg-dark bg-opacity-50 d-none" style="z-index: 2000; backdrop-filter: blur(5px);">
    <div class="container mt-5">
        <div class="card border-0 shadow-lg rounded-4 overflow-hidden mx-auto" style="max-width: 650px;">
            <div class="card-body p-3 bg-white d-flex align-items-center gap-2 border-bottom">
                <i class="bi bi-search text-muted fs-4"></i>
                <input type="text" id="searchInput" class="form-control border-0 shadow-none fs-5" placeholder="Search notices, events, resources, posts...">
                <button type="button" class="btn-close" id="closeSearch"></button>
            </div>
            <div id="searchResults" class="p-3 bg-light" style="max-height: 400px; overflow-y: auto;">
                <div class="text-center text-muted p-3">Type at least 2 characters to search...</div>
            </div>
        </div>
    </div>
</div>
