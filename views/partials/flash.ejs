<% if (typeof success_msg !== 'undefined' && success_msg.length > 0) { %>
    <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4 p-3 d-flex align-items-center gap-2" role="alert" style="background: rgba(16, 185, 129, 0.12); color: var(--success); border: 1px solid rgba(16, 185, 129, 0.25) !important;">
        <i class="bi bi-check-circle-fill fs-5"></i>
        <div class="fw-semibold"><%= success_msg %></div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<% if (typeof error_msg !== 'undefined' && error_msg.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4 p-3 d-flex align-items-center gap-2" role="alert" style="background: rgba(239, 68, 68, 0.12); color: var(--danger); border: 1px solid rgba(239, 68, 68, 0.25) !important;">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <div class="fw-semibold"><%= error_msg %></div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>

<% if (typeof error !== 'undefined' && error.length > 0) { %>
    <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 mb-4 p-3 d-flex align-items-center gap-2" role="alert" style="background: rgba(239, 68, 68, 0.12); color: var(--danger); border: 1px solid rgba(239, 68, 68, 0.25) !important;">
        <i class="bi bi-exclamation-triangle-fill fs-5"></i>
        <div class="fw-semibold"><%= error %></div>
        <button type="button" class="btn-close ms-auto" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
<% } %>
