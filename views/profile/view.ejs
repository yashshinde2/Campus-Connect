<div class="row justify-content-center">
    <div class="col-md-6 text-center">
        <div class="card card-custom p-4 shadow-lg">
            <div class="avatar-initials mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2rem;">
                <%= student.name.charAt(0).toUpperCase() %>
            </div>
            <h3 class="fw-bold mb-1"><%= student.name %></h3>
            <p class="text-muted mb-2"><%= student.course %> • <%= student.department %></p>
            <p class="small text-muted mb-3"><%= student.bio || 'No bio provided.' %></p>
        </div>
    </div>
</div>
