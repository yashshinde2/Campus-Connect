<div class="row g-4">
    <!-- Profile Info Card -->
    <div class="col-md-4">
        <div class="card card-custom p-4 text-center">
            <div class="avatar-initials mx-auto mb-3" style="width: 80px; height: 80px; font-size: 2rem;">
                <%= profile.name.charAt(0).toUpperCase() %>
            </div>
            <h4 class="fw-bold mb-1"><%= profile.name %></h4>
            <p class="text-muted small mb-2"><%= profile.course %> • <%= profile.department %></p>
            <span class="badge bg-primary-subtle text-primary mb-3 text-capitalize"><%= profile.role %></span>
            <p class="small text-muted"><%= profile.bio || 'No bio added yet.' %></p>
        </div>
    </div>

    <!-- Edit Profile & Tabs -->
    <div class="col-md-8">
        <div class="card card-custom p-4">
            <h5 class="fw-bold mb-3">Edit Profile Details</h5>
            <form action="/profile" method="POST" enctype="multipart/form-data">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" name="name" class="form-control" id="pName" value="<%= profile.name %>" required>
                            <label for="pName">Full Name</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="email" class="form-control" id="pEmail" value="<%= profile.email %>" disabled>
                            <label for="pEmail">Email Address (Read-only)</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" name="course" class="form-control" id="pCourse" value="<%= profile.course %>">
                            <label for="pCourse">Course</label>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <div class="form-floating">
                            <input type="text" name="department" class="form-control" id="pDept" value="<%= profile.department %>">
                            <label for="pDept">Department</label>
                        </div>
                    </div>
                    <div class="col-12">
                        <div class="form-floating">
                            <textarea name="bio" class="form-control" id="pBio" style="height: 80px;"><%= profile.bio %></textarea>
                            <label for="pBio">Bio</label>
                        </div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary-gradient px-4">Save Changes</button>
            </form>
        </div>
    </div>
</div>
