<div class="row justify-content-center align-items-center min-vh-75 text-center">
    <div class="col-md-6">
        <h1 class="display-1 fw-extrabold text-danger">500</h1>
        <h3 class="fw-bold mb-3">Internal Server Error</h3>
        <p class="text-muted mb-4"><%= typeof error !== 'undefined' ? error : 'Something went wrong on our server. Please try again later.' %></p>
        <a href="/" class="btn btn-primary-gradient px-4 py-2">
            <i class="bi bi-arrow-left me-1"></i> Return Home
        </a>
    </div>
</div>
