<div class="container py-4">
    <div class="row mb-4 align-items-center gy-3">
        <div class="col-md-6">
            <span class="badge badge-event mb-2">Campus Activities</span>
            <h1 class="display-5 fw-extrabold font-heading mb-1">Campus Events</h1>
            <p class="text-secondary-custom small mb-0">Hackathons, tech talks, workshops, and student fests</p>
        </div>
        <div class="col-md-6">
            <form action="/events" method="GET" class="d-flex gap-2">
                <input type="text" name="search" class="form-control rounded-pill ps-4" placeholder="Search events..." value="<%= currentSearch %>">
                <button type="submit" class="btn btn-aurora rounded-pill px-4"><i class="bi bi-search"></i></button>
            </form>
        </div>
    </div>

    <!-- Tabs -->
    <div class="d-flex gap-2 mb-4 p-2 rounded-pill bg-surface border border-hairline shadow-sm w-fit">
        <a href="/events?tab=upcoming" class="btn btn-sm <%= currentTab === 'upcoming' ? 'btn-aurora' : 'btn-aurora-secondary' %> rounded-pill px-4">Upcoming Events</a>
        <a href="/events?tab=past" class="btn btn-sm <%= currentTab === 'past' ? 'btn-aurora' : 'btn-aurora-secondary' %> rounded-pill px-4">Past Events</a>
    </div>

    <!-- Events Grid -->
    <div class="row g-4 mb-4">
        <% if (events && events.length > 0) { %>
            <% events.forEach(event => { %>
                <div class="col-md-6 col-lg-4">
                    <div class="bento-card spotlight-card h-100 p-4">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <span class="badge badge-event">
                                <i class="bi bi-calendar-event me-1"></i> <%= new Date(event.date).toLocaleDateString() %>
                            </span>
                            <span class="small text-muted"><i class="bi bi-clock me-1"></i> <%= event.time %></span>
                        </div>

                        <h5 class="fw-bold font-heading mb-2"><%= event.title %></h5>
                        <p class="text-secondary-custom small mb-3 flex-grow-1"><%= event.description ? event.description.substring(0, 95) : '' %>...</p>

                        <div class="small text-secondary-custom mb-3">
                            <i class="bi bi-geo-alt me-1 text-primary"></i> <%= event.venue %>
                        </div>

                        <!-- Capacity Bar -->
                        <% const percent = Math.min(100, Math.round(((event.attendees ? event.attendees.length : 0) / (event.capacity || 100)) * 100)); %>
                        <div class="mb-3">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Attendance</span>
                                <span><%= event.attendees ? event.attendees.length : 0 %> / <%= event.capacity %></span>
                            </div>
                            <div class="progress" style="height: 6px; background: var(--surface-2);">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: <%= percent %>%;"></div>
                            </div>
                        </div>

                        <div class="d-flex align-items-center justify-content-between border-top pt-3">
                            <a href="/events/<%= event._id %>" class="btn btn-aurora-soft btn-sm w-100 text-center">View Details & RSVP</a>
                        </div>
                    </div>
                </div>
            <% }) %>
        <% } else { %>
            <div class="col-12 text-center py-5 text-muted bento-card">
                <i class="bi bi-calendar-x fs-1 d-block mb-2 text-primary opacity-50"></i>
                No events listed in this section.
            </div>
        <% } %>
    </div>
</div>
