<div class="row mb-4 align-items-center">
    <div class="col-md-6">
        <h2 class="fw-bold mb-1">Campus Events</h2>
        <p class="text-muted small mb-0">Hackathons, workshops, cultural nights & guest lectures</p>
    </div>
    <div class="col-md-6">
        <form action="/events" method="GET" class="d-flex gap-2">
            <input type="text" name="search" class="form-control" placeholder="Search events..." value="<%= currentSearch %>">
            <button type="submit" class="btn btn-primary-gradient px-4"><i class="bi bi-search"></i></button>
        </form>
    </div>
</div>

<!-- Tabs -->
<ul class="nav nav-pills mb-4 gap-2">
    <li class="nav-item">
        <a href="/events?tab=upcoming" class="nav-link rounded-pill <%= currentTab === 'upcoming' ? 'active bg-primary' : '' %>">Upcoming Events</a>
    </li>
    <li class="nav-item">
        <a href="/events?tab=past" class="nav-link rounded-pill <%= currentTab === 'past' ? 'active bg-primary' : '' %>">Past Events</a>
    </li>
</ul>

<!-- Events Grid -->
<div class="row g-4 mb-4">
    <% if (events && events.length > 0) { %>
        <% events.forEach(event => { %>
            <div class="col-md-6 col-lg-4">
                <div class="card card-custom p-4 h-100">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge bg-violet-subtle text-violet fw-bold px-3 py-2 rounded-pill">
                            <i class="bi bi-calendar-event me-1"></i> <%= new Date(event.date).toLocaleDateString() %>
                        </span>
                        <span class="small text-muted"><%= event.time %></span>
                    </div>

                    <h5 class="fw-bold mb-2"><%= event.title %></h5>
                    <p class="text-muted small mb-3 flex-grow-1"><%= event.description.substring(0, 90) %>...</p>

                    <div class="small text-muted mb-3">
                        <i class="bi bi-geo-alt me-1 text-primary"></i> <%= event.venue %>
                    </div>

                    <div class="d-flex align-items-center justify-content-between border-top pt-3">
                        <span class="small text-muted"><i class="bi bi-people me-1"></i> <%= event.attendees.length %> / <%= event.capacity %> Attending</span>
                        <a href="/events/<%= event._id %>" class="btn btn-sm btn-soft">Details & RSVP</a>
                    </div>
                </div>
            </div>
        <% }) %>
    <% } else { %>
        <div class="col-12 text-center py-5 text-muted">No events listed in this section.</div>
    <% } %>
</div>
