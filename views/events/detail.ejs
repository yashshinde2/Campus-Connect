<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-custom p-4 p-md-5 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge bg-violet-subtle text-violet fs-6 px-3 py-2 rounded-pill">
                    <i class="bi bi-calendar-event me-1"></i> <%= new Date(event.date).toLocaleDateString() %>
                </span>
                <span class="text-muted"><i class="bi bi-clock me-1"></i> <%= event.time %></span>
            </div>

            <h2 class="fw-bold mb-3"><%= event.title %></h2>

            <div class="card p-3 bg-light border-0 rounded-3 mb-4">
                <div class="row g-2 text-center">
                    <div class="col-md-6 border-end">
                        <small class="text-muted">Venue</small>
                        <div class="fw-bold text-dark"><i class="bi bi-geo-alt text-primary me-1"></i> <%= event.venue %></div>
                    </div>
                    <div class="col-md-6">
                        <small class="text-muted">Attendees</small>
                        <div class="fw-bold text-dark"><i class="bi bi-people text-violet me-1"></i> <span id="attendeeCount-<%= event._id %>"><%= event.attendees.length %></span> / <%= event.capacity %></div>
                    </div>
                </div>
            </div>

            <div class="fs-6 lh-lg text-dark mb-4">
                <%= event.description %>
            </div>

            <div class="d-flex flex-wrap align-items-center justify-content-between border-top pt-4 gap-2">
                <a href="/events" class="btn btn-soft"><i class="bi bi-arrow-left me-1"></i> Back to Events</a>

                <div class="d-flex gap-2">
                    <a href="/events/<%= event._id %>/ics" class="btn btn-outline-secondary">
                        <i class="bi bi-download me-1"></i> Add to Calendar (.ics)
                    </a>

                    <% if (isAttending) { %>
                        <button class="btn btn-success btn-rsvp" data-id="<%= event._id %>">
                            <i class="bi bi-check-circle-fill me-1"></i> Attending
                        </button>
                    <% } else { %>
                        <button class="btn btn-primary-gradient btn-rsvp" data-id="<%= event._id %>">
                            <i class="bi bi-calendar-check me-1"></i> RSVP Event
                        </button>
                    <% } %>
                </div>
            </div>
        </div>
    </div>
</div>
