<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="bento-card spotlight-card p-4 p-md-5 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge badge-event fs-6 px-3 py-2">
                        <i class="bi bi-calendar-event me-1"></i> <%= new Date(event.date).toLocaleDateString() %>
                    </span>
                    <span class="text-secondary-custom"><i class="bi bi-clock me-1 text-primary"></i> <%= event.time %></span>
                </div>

                <h1 class="display-6 fw-extrabold font-heading mb-4"><%= event.title %></h1>

                <div class="p-3 rounded-4 bg-surface-2 border border-hairline mb-4">
                    <div class="row g-3 text-center">
                        <div class="col-md-6 border-end">
                            <small class="text-muted">Venue Location</small>
                            <div class="fw-bold fs-5 text-dark dark-text-light"><i class="bi bi-geo-alt text-primary me-1"></i> <%= event.venue %></div>
                        </div>
                        <div class="col-md-6">
                            <small class="text-muted">Current RSVP Status</small>
                            <div class="fw-bold fs-5 text-dark dark-text-light">
                                <i class="bi bi-people text-violet me-1"></i> 
                                <span id="attendeeCount-<%= event._id %>"><%= event.attendees.length %></span> / <%= event.capacity %> Attending
                            </div>
                        </div>
                    </div>
                </div>

                <div class="fs-6 lh-lg text-secondary-custom mb-4">
                    <%= event.description %>
                </div>

                <div class="d-flex flex-wrap align-items-center justify-content-between border-top pt-4 gap-3">
                    <a href="/events" class="btn btn-aurora-secondary"><i class="bi bi-arrow-left me-1"></i> Back to Events</a>

                    <div class="d-flex gap-2">
                        <a href="/events/<%= event._id %>/ics" class="btn btn-aurora-soft">
                            <i class="bi bi-download me-1"></i> Add to Calendar (.ics)
                        </a>

                        <% if (isAttending) { %>
                            <button class="btn btn-success btn-rsvp rounded-pill px-4" data-id="<%= event._id %>">
                                <i class="bi bi-check-circle-fill me-1"></i> Attending
                            </button>
                        <% } else { %>
                            <button class="btn btn-aurora btn-shine btn-rsvp rounded-pill px-4" data-id="<%= event._id %>">
                                <i class="bi bi-calendar-check me-1"></i> RSVP Event
                            </button>
                        <% } %>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
