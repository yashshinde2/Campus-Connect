<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-custom p-4 p-md-5 mb-4">
            <div class="d-flex align-items-center gap-3 mb-3">
                <div class="avatar-initials">
                    <%= post.author ? post.author.name.charAt(0).toUpperCase() : 'U' %>
                </div>
                <div>
                    <div class="fw-bold"><%= post.author ? post.author.name : 'Student' %></div>
                    <small class="text-muted"><%= new Date(post.createdAt).toLocaleDateString() %></small>
                </div>
                <span class="badge bg-light text-primary border ms-auto"><%= post.topic %></span>
            </div>

            <h3 class="fw-bold mb-3"><%= post.title %></h3>
            <div class="fs-6 lh-lg text-dark mb-4" style="white-space: pre-line;">
                <%= post.content %>
            </div>

            <% if (user && (user._id.toString() === post.author._id.toString() || user.role === 'admin')) { %>
                <form action="/community/<%= post._id %>/delete" method="POST" class="d-inline mb-4">
                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete this post?')">
                        <i class="bi bi-trash me-1"></i> Delete Post
                    </button>
                </form>
            <% } %>

            <hr class="my-4">

            <h5 class="fw-bold mb-4">Comments (<%= comments.length %>)</h5>

            <!-- Comment Input -->
            <form action="/community/<%= post._id %>/comment" method="POST" class="mb-4">
                <div class="form-floating mb-2">
                    <textarea name="content" class="form-control" id="cInput" style="height: 80px;" placeholder="Comment" required></textarea>
                    <label for="cInput">Write a comment...</label>
                </div>
                <button type="submit" class="btn btn-primary-gradient btn-sm px-3">Post Comment</button>
            </form>

            <!-- Comments List -->
            <div class="d-flex flex-column gap-3">
                <% if (comments && comments.length > 0) { %>
                    <% comments.forEach(comment => { %>
                        <div class="p-3 bg-light rounded-3 border">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <span class="fw-bold small"><%= comment.author ? comment.author.name : 'Student' %></span>
                                <small class="text-muted"><%= new Date(comment.createdAt).toLocaleDateString() %></small>
                            </div>
                            <p class="small mb-0 text-dark"><%= comment.content %></p>
                        </div>
                    <% }) %>
                <% } else { %>
                    <div class="text-muted small text-center py-3">No comments yet. Be the first to reply!</div>
                <% } %>
            </div>
        </div>
    </div>
</div>
