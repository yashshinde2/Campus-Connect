<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-8 col-lg-7">
            <div class="bento-card spotlight-card p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="icon-tile icon-tile-gradient rounded-circle mx-auto mb-3" style="width: 50px; height: 50px; font-size: 1.3rem;">
                        <i class="bi bi-chat-square-text"></i>
                    </div>
                    <h2 class="fw-extrabold font-heading">Create Community Post</h2>
                    <p class="text-secondary-custom small">Share project ideas, questions, or campus news with your peers</p>
                </div>

                <form action="/community/create" method="POST">
                    <div class="form-floating mb-3">
                        <input type="text" name="title" class="form-control" id="pTitle" placeholder="Title" required>
                        <label for="pTitle">Post Title</label>
                    </div>

                    <div class="form-floating mb-3">
                        <select name="topic" class="form-select" id="pTopic">
                            <option value="General">General</option>
                            <option value="Academics">Academics</option>
                            <option value="Projects">Projects</option>
                            <option value="Career">Career</option>
                            <option value="Tech">Tech</option>
                        </select>
                        <label for="pTopic">Topic</label>
                    </div>

                    <div class="form-floating mb-4">
                        <textarea name="content" class="form-control" id="pContent" style="height: 150px;" placeholder="Content" required></textarea>
                        <label for="pContent">What's on your mind?</label>
                    </div>

                    <div class="d-flex justify-content-between align-items-center">
                        <a href="/community" class="btn btn-aurora-secondary">Cancel</a>
                        <button type="submit" class="btn btn-aurora btn-shine px-4 justify-content-center">
                            Publish Post <i class="bi bi-send ms-1"></i>
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
