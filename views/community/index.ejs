<div class="container py-4">
    <div class="row mb-4 align-items-center gy-3">
        <div class="col-md-6">
            <span class="badge badge-general mb-2">Student Forum</span>
            <h1 class="display-5 fw-extrabold font-heading mb-1">Community Discussions</h1>
            <p class="text-secondary-custom small mb-0">Ask questions, share project ideas, and discuss academic topics</p>
        </div>
        <div class="col-md-6 d-flex gap-2">
            <form action="/community" method="GET" class="d-flex gap-2 flex-grow-1">
                <input type="text" name="search" class="form-control rounded-pill ps-4" placeholder="Search discussions..." value="<%= currentSearch %>">
                <button type="submit" class="btn btn-aurora rounded-pill px-4"><i class="bi bi-search"></i></button>
            </form>
            <a href="/community/create" class="btn btn-aurora btn-shine text-nowrap"><i class="bi bi-plus-lg me-1"></i> New Post</a>
        </div>
    </div>

    <!-- Posts Feed Grid -->
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <% if (posts && posts.length > 0) { %>
                <% posts.forEach(post => { %>
                    <div class="bento-card spotlight-card p-4 mb-3">
                        <div class="d-flex align-items-center gap-3 mb-3">
                            <div class="avatar-pill" style="width: 42px; height: 42px;">
                                <%= post.author ? post.author.name.charAt(0).toUpperCase() : 'U' %>
                            </div>
                            <div>
                                <div class="fw-bold"><%= post.author ? post.author.name : 'Student' %></div>
                                <small class="text-muted"><%= new Date(post.createdAt).toLocaleDateString() %></small>
                            </div>
                            <span class="badge bg-surface border text-primary ms-auto fw-bold"><%= post.topic %></span>
                        </div>

                        <h5 class="fw-bold font-heading mb-2">
                            <a href="/community/<%= post._id %>" class="text-decoration-none text-dark dark-text-light"><%= post.title %></a>
                        </h5>
                        <p class="text-secondary-custom small mb-3"><%= post.content ? post.content.substring(0, 160) : '' %>...</p>

                        <div class="d-flex align-items-center justify-content-between border-top pt-3 small text-muted">
                            <div class="d-flex align-items-center gap-3">
                                <span><i class="bi bi-chat-square-text me-1 text-primary"></i> <%= post.commentCount || 0 %> Comments</span>
                            </div>
                            <a href="/community/<%= post._id %>" class="btn btn-aurora-soft btn-sm">Read Discussion <i class="bi bi-arrow-right"></i></a>
                        </div>
                    </div>
                <% }) %>
            <% } else { %>
                <div class="text-center py-5 text-muted bento-card">
                    <i class="bi bi-chat-square-dots fs-1 d-block mb-2 text-primary opacity-50"></i>
                    No community discussions found. Start a new topic!
                </div>
            <% } %>
        </div>
    </div>
</div>
