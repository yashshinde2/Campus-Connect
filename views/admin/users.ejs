<h3 class="fw-bold mb-4">User Management</h3>
<div class="card card-custom p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Role</th>
                    <th>Department</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% users.forEach(u => { %>
                    <tr>
                        <td class="fw-bold"><%= u.name %></td>
                        <td><%= u.email %></td>
                        <td><span class="badge bg-light text-dark border"><%= u.role %></span></td>
                        <td><%= u.department || '-' %></td>
                        <td>
                            <% if (u.isActive) { %>
                                <span class="badge bg-success-subtle text-success">Active</span>
                            <% } else { %>
                                <span class="badge bg-danger-subtle text-danger">Blocked</span>
                            <% } %>
                        </td>
                        <td>
                            <% if (u.role !== 'admin') { %>
                                <form action="/admin/users/<%= u._id %>/toggle" method="POST" class="d-inline me-1">
                                    <button type="submit" class="btn btn-sm <%= u.isActive ? 'btn-outline-warning' : 'btn-outline-success' %>">
                                        <%= u.isActive ? 'Block' : 'Unblock' %>
                                    </button>
                                </form>
                                <form action="/admin/users/<%= u._id %>/delete" method="POST" class="d-inline">
                                    <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete user?')">Delete</button>
                                </form>
                            <% } %>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
