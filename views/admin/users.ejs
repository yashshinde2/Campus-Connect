<div class="container-fluid px-lg-4 py-4">
    <div class="mb-4">
        <span class="badge bg-danger-subtle text-danger mb-1 fw-bold">Admin Panel</span>
        <h1 class="display-6 fw-extrabold font-heading mb-0">Student & User Management</h1>
    </div>

    <div class="bento-card spotlight-card p-4">
        <div class="table-responsive">
            <table class="table-aurora">
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Department</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (users && users.length > 0) { %>
                        <% users.forEach(u => { %>
                            <tr>
                                <td class="fw-bold"><%= u.name %></td>
                                <td><%= u.email %></td>
                                <td><span class="badge bg-surface border text-dark dark-text-light text-capitalize"><%= u.role %></span></td>
                                <td><%= u.department || '-' %></td>
                                <td>
                                    <% if (u.isActive) { %>
                                        <span class="badge bg-success-subtle text-success">Active</span>
                                    <% } else { %>
                                        <span class="badge bg-danger-subtle text-danger">Blocked</span>
                                    <% } %>
                                </td>
                                <td>
                                    <% if (u.role !== 'admin') { %>
                                        <form action="/admin/users/<%= u._id %>/toggle" method="POST" class="d-inline me-1">
                                            <button type="submit" class="btn btn-sm <%= u.isActive ? 'btn-outline-warning' : 'btn-outline-success' %> rounded-pill px-3">
                                                <%= u.isActive ? 'Block' : 'Unblock' %>
                                            </button>
                                        </form>
                                        <form action="/admin/users/<%= u._id %>/delete" method="POST" class="d-inline">
                                            <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('Delete user?')">Delete</button>
                                        </form>
                                    <% } %>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="6" class="text-center py-4 text-muted">No users found.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>
