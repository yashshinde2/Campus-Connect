<div class="container-fluid px-lg-4 py-4">
    <!-- Admin Top Header -->
    <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3 mb-4">
        <div>
            <span class="badge bg-danger-subtle text-danger mb-1 fw-bold"><i class="bi bi-shield-lock me-1"></i> Admin Console</span>
            <h1 class="display-6 fw-extrabold font-heading mb-0">System Overview</h1>
        </div>
        <div class="d-flex align-items-center gap-2">
            <a href="/admin/export/users" class="btn btn-aurora-secondary btn-sm"><i class="bi bi-download me-1"></i> Export Students CSV</a>
            <a href="/admin/settings" class="btn btn-aurora-soft btn-sm"><i class="bi bi-gear me-1"></i> Settings</a>
        </div>
    </div>

    <!-- Admin Quick Navigation Toolbar -->
    <div class="bento-card spotlight-card p-3 mb-4">
        <div class="d-flex flex-wrap gap-2">
            <a href="/admin" class="btn btn-aurora btn-sm"><i class="bi bi-speedometer2 me-1"></i> Overview</a>
            <a href="/admin/notices" class="btn btn-aurora-secondary btn-sm"><i class="bi bi-megaphone me-1"></i> Notices</a>
            <a href="/admin/events" class="btn btn-aurora-secondary btn-sm"><i class="bi bi-calendar-event me-1"></i> Events</a>
            <a href="/admin/users" class="btn btn-aurora-secondary btn-sm"><i class="bi bi-people me-1"></i> Users</a>
            <a href="/admin/resources" class="btn btn-aurora-secondary btn-sm"><i class="bi bi-folder2-open me-1"></i> Resource Moderation</a>
            <a href="/admin/community" class="btn btn-aurora-secondary btn-sm"><i class="bi bi-chat-square-text me-1"></i> Community Moderation</a>
            <a href="/admin/messages" class="btn btn-aurora-secondary btn-sm"><i class="bi bi-envelope me-1"></i> Messages</a>
            <a href="/admin/logs" class="btn btn-aurora-secondary btn-sm"><i class="bi bi-journal-text me-1"></i> Activity Logs</a>
        </div>
    </div>

    <!-- 4 Bento Stat Tiles -->
    <div class="row g-3 mb-4">
        <div class="col-6 col-md-3">
            <div class="bento-card spotlight-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-tile icon-tile-gradient"><i class="bi bi-people-fill"></i></div>
                    <div>
                        <h3 class="fw-extrabold mb-0 counter" data-target="<%= stats.studentCount || 0 %>">0</h3>
                        <small class="text-muted fw-semibold">Students</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bento-card spotlight-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-tile" style="background: rgba(245,158,11,0.12); color: var(--warning);"><i class="bi bi-folder-symlink"></i></div>
                    <div>
                        <h3 class="fw-extrabold mb-0 text-warning counter" data-target="<%= stats.pendingResourceCount || 0 %>">0</h3>
                        <small class="text-muted fw-semibold">Pending Approval</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bento-card spotlight-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-tile" style="background: rgba(79,70,229,0.12); color: var(--indigo);"><i class="bi bi-megaphone-fill"></i></div>
                    <div>
                        <h3 class="fw-extrabold mb-0 text-indigo counter" data-target="<%= stats.noticeCount || 0 %>">0</h3>
                        <small class="text-muted fw-semibold">Notices</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-6 col-md-3">
            <div class="bento-card spotlight-card p-3">
                <div class="d-flex align-items-center gap-3">
                    <div class="icon-tile" style="background: rgba(139,92,246,0.12); color: var(--violet-accent);"><i class="bi bi-calendar-event-fill"></i></div>
                    <div>
                        <h3 class="fw-extrabold mb-0 counter" style="color: var(--violet-accent);" data-target="<%= stats.totalEventCount || 0 %>">0</h3>
                        <small class="text-muted fw-semibold">Events</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Hand-built SVG Charts Bento Section -->
    <div class="row g-4 mb-4">
        <!-- SVG Line Chart: Monthly Signups (Span 7) -->
        <div class="col-lg-7">
            <div class="bento-card spotlight-card h-100 p-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <div>
                        <h5 class="fw-extrabold font-heading mb-0">Student Growth Trend</h5>
                        <small class="text-muted">Monthly student registrations in 2026</small>
                    </div>
                    <span class="badge bg-primary-subtle text-primary fw-bold">+42% this month</span>
                </div>
                <div id="lineChartSignups" style="height: 220px; min-height: 200px;"></div>
            </div>
        </div>

        <!-- SVG Donut & Bar Charts (Span 5) -->
        <div class="col-lg-5">
            <div class="bento-card spotlight-card h-100 p-4">
                <h5 class="fw-extrabold font-heading mb-3">Study Hub Content Split</h5>
                <div id="donutChartResources" class="py-2"></div>
            </div>
        </div>
    </div>

    <!-- Category Notice Bar Chart -->
    <div class="bento-card spotlight-card p-4">
        <h5 class="fw-extrabold font-heading mb-3">Notices Breakdown by Category</h5>
        <div id="barChartNotices"></div>
    </div>
</div>

<script src="/js/modules/charts.js"></script>
