<h3 class="fw-bold mb-4">Resource Moderation Queue</h3>
<div class="card card-custom p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Subject</th>
                    <th>Uploaded By</th>
                    <th>Format</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% resources.forEach(r => { %>
                    <tr>
                        <td class="fw-bold"><%= r.title %></td>
                        <td><%= r.subject %></td>
                        <td><%= r.uploadedBy ? r.uploadedBy.name : 'Unknown' %></td>
                        <td><span class="badge bg-light text-primary border text-uppercase"><%= r.type %></span></td>
                        <td>
                            <% if (r.status === 'approved') { %>
                                <span class="badge bg-success-subtle text-success">Approved</span>
                            <% } else if (r.status === 'pending') { %>
                                <span class="badge bg-warning-subtle text-warning">Pending</span>
                            <% } else { %>
                                <span class="badge bg-danger-subtle text-danger">Rejected</span>
                            <% } %>
                        </td>
                        <td>
                            <% if (r.status === 'pending') { %>
                                <form action="/admin/resources/<%= r._id %>/approve" method="POST" class="d-inline me-1">
                                    <button type="submit" class="btn btn-sm btn-success">Approve</button>
                                </form>
                                <form action="/admin/resources/<%= r._id %>/reject" method="POST" class="d-inline me-1">
                                    <button type="submit" class="btn btn-sm btn-warning">Reject</button>
                                </form>
                            <% } %>
                            <form action="/admin/resources/<%= r._id %>/delete" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete resource?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
