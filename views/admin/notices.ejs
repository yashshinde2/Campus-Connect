<div class="container-fluid px-lg-4 py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <span class="badge bg-danger-subtle text-danger mb-1 fw-bold">Admin Panel</span>
            <h1 class="display-6 fw-extrabold font-heading mb-0">Manage Campus Notices</h1>
        </div>
        <button class="btn btn-aurora btn-shine" data-bs-toggle="modal" data-bs-target="#createNoticeModal">
            <i class="bi bi-plus-lg me-1"></i> Create Notice
        </button>
    </div>

    <div class="bento-card spotlight-card p-4">
        <div class="table-responsive">
            <table class="table-aurora">
                <thead>
                    <tr>
                        <th>Title</th>
                        <th>Category</th>
                        <th>Pinned</th>
                        <th>Urgent</th>
                        <th>Created</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (notices && notices.length > 0) { %>
                        <% notices.forEach(n => { %>
                            <tr>
                                <td class="fw-bold"><%= n.title %></td>
                                <td><span class="badge badge-category badge-<%= n.category ? n.category.toLowerCase() : 'general' %>"><%= n.category %></span></td>
                                <td><%= n.isPinned ? 'Yes' : 'No' %></td>
                                <td><%= n.isUrgent ? 'Yes' : 'No' %></td>
                                <td><%= new Date(n.createdAt).toLocaleDateString() %></td>
                                <td>
                                    <form action="/admin/notices/<%= n._id %>/delete" method="POST" class="d-inline">
                                        <button type="submit" class="btn btn-sm btn-outline-danger rounded-pill px-3" onclick="return confirm('Delete notice?')">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }) %>
                    <% } else { %>
                        <tr><td colspan="6" class="text-center py-4 text-muted">No notices created yet.</td></tr>
                    <% } %>
                </tbody>
            </table>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="createNoticeModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content bento-card p-4 border-0">
            <form action="/admin/notices" method="POST">
                <div class="modal-header border-bottom pb-3 mb-3" style="border-color: var(--line) !important;">
                    <h5 class="modal-title fw-extrabold font-heading">Create Campus Notice</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="form-floating mb-3">
                        <input type="text" name="title" class="form-control" id="ntTitle" placeholder="Title" required>
                        <label for="ntTitle">Notice Title</label>
                    </div>
                    <div class="form-floating mb-3">
                        <select name="category" class="form-select" id="ntCat" required>
                            <option value="Academic">Academic</option>
                            <option value="Exam">Exam</option>
                            <option value="Event">Event</option>
                            <option value="General">General</option>
                            <option value="Placement">Placement</option>
                        </select>
                        <label for="ntCat">Category</label>
                    </div>
                    <div class="form-floating mb-3">
                        <textarea name="description" class="form-control" id="ntDesc" style="height: 120px;" placeholder="Description" required></textarea>
                        <label for="ntDesc">Notice Content</label>
                    </div>
                    <div class="form-check mb-2">
                        <input type="checkbox" name="isPinned" class="form-check-input" id="pinCheck">
                        <label class="form-check-label small fw-semibold text-secondary-custom" for="pinCheck">Pin to Top of Feed</label>
                    </div>
                    <div class="form-check mb-3">
                        <input type="checkbox" name="isUrgent" class="form-check-input" id="urgCheck">
                        <label class="form-check-label small fw-semibold text-danger" for="urgCheck">Mark as Urgent (Pulsing Dot)</label>
                    </div>
                </div>
                <div class="modal-footer border-top pt-3" style="border-color: var(--line) !important;">
                    <button type="submit" class="btn btn-aurora btn-shine w-100 py-2.5 justify-content-center">Publish Notice</button>
                </div>
            </form>
        </div>
    </div>
</div>
