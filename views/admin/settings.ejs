<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="bento-card spotlight-card p-4 p-md-5">
                <div class="text-center mb-4">
                    <div class="icon-tile icon-tile-gradient rounded-circle mx-auto mb-3" style="width: 50px; height: 50px; font-size: 1.3rem;">
                        <i class="bi bi-gear"></i>
                    </div>
                    <h2 class="fw-extrabold font-heading">Site Announcement Banner</h2>
                    <p class="text-secondary-custom small">Configure global announcement bar broadcast across all pages</p>
                </div>

                <form action="/admin/settings" method="POST">
                    <div class="form-check form-switch mb-4 p-3 rounded-3 bg-surface-2 border border-hairline d-flex align-items-center justify-content-between">
                        <label class="form-check-label fw-bold text-dark dark-text-light mb-0" for="annSwitch">Enable Announcement Banner</label>
                        <input type="checkbox" name="enabled" class="form-check-input ms-0" style="width: 2.5rem; height: 1.25rem;" id="annSwitch" <%= announcement.enabled ? 'checked' : '' %>>
                    </div>

                    <div class="form-floating mb-3">
                        <input type="text" name="text" class="form-control" id="annText" value="<%= announcement.text || '' %>" placeholder="Text">
                        <label for="annText">Banner Text Message</label>
                    </div>

                    <div class="form-floating mb-4">
                        <select name="type" class="form-select" id="annType">
                            <option value="info" <%= announcement.type === 'info' ? 'selected' : '' %>>Info (Blue Tint)</option>
                            <option value="warning" <%= announcement.type === 'warning' ? 'selected' : '' %>>Warning (Yellow Tint)</option>
                            <option value="danger" <%= announcement.type === 'danger' ? 'selected' : '' %>>Alert (Red Tint)</option>
                        </select>
                        <label for="annType">Alert Variant Style</label>
                    </div>

                    <button type="submit" class="btn btn-aurora btn-shine w-100 py-3 justify-content-center">Save Banner Settings</button>
                </form>
            </div>
        </div>
    </div>
</div>
