<h3 class="fw-bold mb-4">Study Groups Moderation</h3>
<div class="card card-custom p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Group Name</th>
                    <th>Created By</th>
                    <th>Members Count</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% groups.forEach(g => { %>
                    <tr>
                        <td class="fw-bold"><%= g.name %></td>
                        <td><%= g.createdBy ? g.createdBy.name : 'Unknown' %></td>
                        <td><%= g.members.length %></td>
                        <td>
                            <form action="/admin/groups/<%= g._id %>/delete" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete study group?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
