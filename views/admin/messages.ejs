<h3 class="fw-bold mb-4">Contact Messages</h3>
<div class="card card-custom p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Email</th>
                    <th>Subject</th>
                    <th>Message</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% messages.forEach(m => { %>
                    <tr>
                        <td class="fw-bold"><%= m.name %></td>
                        <td><%= m.email %></td>
                        <td><%= m.subject %></td>
                        <td style="max-width: 250px;"><%= m.message %></td>
                        <td>
                            <form action="/admin/messages/<%= m._id %>/delete" method="POST" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-danger" onclick="return confirm('Delete message?')">Delete</button>
                            </form>
                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
