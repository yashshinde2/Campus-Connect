<h3 class="fw-bold mb-4">Administrator Activity Logs</h3>
<div class="card card-custom p-4">
    <div class="table-responsive">
        <table class="table table-hover align-middle">
            <thead>
                <tr>
                    <th>Admin</th>
                    <th>Action</th>
                    <th>Target Type</th>
                    <th>Timestamp</th>
                </tr>
            </thead>
            <tbody>
                <% logs.forEach(l => { %>
                    <tr>
                        <td class="fw-bold"><%= l.admin ? l.admin.name : 'System Admin' %></td>
                        <td><%= l.action %></td>
                        <td><span class="badge bg-light text-dark border"><%= l.targetType %></span></td>
                        <td><%= new Date(l.createdAt).toLocaleString() %></td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    </div>
</div>
