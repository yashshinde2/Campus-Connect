<div class="row mb-4 align-items-center">
    <div class="col-md-6">
        <h2 class="fw-bold mb-1">Campus Notices</h2>
        <p class="text-muted small mb-0">Official academic announcements, exam timetables, and placement alerts</p>
    </div>
    <div class="col-md-6">
        <form action="/notices" method="GET" class="d-flex gap-2">
            <input type="text" name="search" class="form-control" placeholder="Search notices..." value="<%= currentSearch %>">
            <button type="submit" class="btn btn-primary-gradient px-4"><i class="bi bi-search"></i></button>
        </form>
    </div>
</div>

<!-- Category Filters -->
<div class="d-flex flex-wrap gap-2 mb-4">
    <% ['All', 'Exam', 'Academic', 'Event', 'General', 'Placement'].forEach(cat => { %>
        <a href="/notices?category=<%= cat %>&search=<%= currentSearch %>" 
           class="btn btn-sm <%= currentCategory === cat ? 'btn-primary-gradient' : 'btn-soft' %> rounded-pill px-3">
            <%= cat %>
        </a>
    <% }) %>
</div>

<!-- Notices Grid -->
<div class="row g-4 mb-4">
    <% if (notices && notices.length > 0) { %>
        <% notices.forEach(notice => { %>
            <div class="col-md-6 col-lg-4">
                <div class="card card-custom p-4 h-100 position-relative">
                    <div class="d-flex justify-content-between align-items-center mb-3">
                        <span class="badge badge-category badge-<%= notice.category.toLowerCase() %>"><%= notice.category %></span>
                        <% if (notice.isPinned) { %>
                            <span class="badge bg-warning-subtle text-warning"><i class="bi bi-pin-angle-fill me-1"></i> Pinned</span>
                        <% } %>
                    </div>
                    <h5 class="fw-bold mb-2">
                        <a href="/notices/<%= notice._id %>" class="text-dark text-decoration-none"><%= notice.title %></a>
                    </h5>
                    <p class="text-muted small mb-3 flex-grow-1"><%= notice.description.substring(0, 100) %>...</p>
                    <div class="d-flex justify-content-between align-items-center border-top pt-3 small text-muted">
                        <span><i class="bi bi-clock me-1"></i> <%= new Date(notice.createdAt).toLocaleDateString() %></span>
                        <a href="/notices/<%= notice._id %>" class="btn btn-sm btn-soft">Read More <i class="bi bi-arrow-right"></i></a>
                    </div>
                </div>
            </div>
        <% }) %>
    <% } else { %>
        <div class="col-12 text-center py-5 text-muted">No notices matching your criteria.</div>
    <% } %>
</div>
