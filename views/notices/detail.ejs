<div class="row justify-content-center">
    <div class="col-lg-8">
        <div class="card card-custom p-4 p-md-5 mb-4">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <span class="badge badge-category badge-<%= notice.category.toLowerCase() %> fs-6 px-3 py-2"><%= notice.category %></span>
                <% if (notice.isUrgent) { %>
                    <span class="badge bg-danger-subtle text-danger fs-6 px-3 py-2"><span class="urgent-pulse me-1"></span> URGENT</span>
                <% } %>
            </div>

            <h2 class="fw-bold mb-3"><%= notice.title %></h2>

            <div class="d-flex flex-wrap gap-4 text-muted small border-top border-bottom py-3 mb-4">
                <div><i class="bi bi-person me-1"></i> Published by: <strong><%= notice.author ? notice.author.name : 'Admin' %></strong></div>
                <div><i class="bi bi-calendar3 me-1"></i> Date: <strong><%= new Date(notice.createdAt).toLocaleDateString() %></strong></div>
                <div><i class="bi bi-eye me-1"></i> Views: <strong><%= notice.views %></strong></div>
            </div>

            <div class="fs-6 lh-lg text-dark mb-4" style="white-space: pre-line;">
                <%= notice.description %>
            </div>

            <% if (notice.deadline) { %>
                <div class="alert alert-warning d-flex align-items-center gap-2 mb-4">
                    <i class="bi bi-clock-history fs-4"></i>
                    <div>
                        <strong>Deadline Notice:</strong> Please take required action before <strong><%= new Date(notice.deadline).toLocaleDateString() %></strong>.
                    </div>
                </div>
            <% } %>

            <div class="d-flex justify-content-between align-items-center border-top pt-4">
                <a href="/notices" class="btn btn-soft"><i class="bi bi-arrow-left me-1"></i> Back to Notices</a>
                <button class="btn btn-outline-primary btn-bookmark" data-id="<%= notice._id %>">
                    <i class="bi bi-bookmark me-1"></i> Bookmark
                </button>
            </div>
        </div>
    </div>
</div>
