<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-9">
            <div class="bento-card spotlight-card p-4 p-md-5 mb-4">
                <div class="d-flex justify-content-between align-items-center mb-3">
                    <span class="badge badge-category badge-<%= notice.category ? notice.category.toLowerCase() : 'general' %> fs-6 px-3 py-2"><%= notice.category %></span>
                    <% if (notice.isUrgent) { %>
                        <span class="badge bg-danger-subtle text-danger fs-6 px-3 py-2"><span class="urgent-pulse me-1"></span> URGENT NOTICE</span>
                    <% } %>
                </div>

                <h1 class="display-6 fw-extrabold font-heading mb-3"><%= notice.title %></h1>

                <div class="d-flex flex-wrap gap-4 text-secondary-custom small border-top border-bottom py-3 mb-4">
                    <div><i class="bi bi-person me-1 text-primary"></i> Published by: <strong><%= notice.author ? notice.author.name : 'Academic Office' %></strong></div>
                    <div><i class="bi bi-calendar3 me-1 text-info"></i> Date: <strong><%= new Date(notice.createdAt).toLocaleDateString() %></strong></div>
                    <div><i class="bi bi-eye me-1 text-warning"></i> Views: <strong><%= notice.views || 1 %></strong></div>
                </div>

                <div class="fs-6 lh-lg text-secondary-custom mb-4" style="white-space: pre-line;">
                    <%= notice.description %>
                </div>

                <% if (notice.deadline) { %>
                    <div class="p-3 rounded-4 bg-warning bg-opacity-10 border border-warning border-opacity-25 text-warning d-flex align-items-center gap-3 mb-4">
                        <i class="bi bi-clock-history fs-3"></i>
                        <div>
                            <strong class="d-block">Action Required Deadline:</strong> Please complete required tasks before <strong><%= new Date(notice.deadline).toLocaleDateString() %></strong>.
                        </div>
                    </div>
                <% } %>

                <div class="d-flex justify-content-between align-items-center border-top pt-4">
                    <a href="/notices" class="btn btn-aurora-secondary"><i class="bi bi-arrow-left me-1"></i> Back to Notices</a>
                    <button class="btn btn-aurora-soft btn-bookmark" data-id="<%= notice._id %>">
                        <i class="bi bi-bookmark me-1"></i> Bookmark
                    </button>
                </div>
            </div>
        </div>
    </div>
</div>
