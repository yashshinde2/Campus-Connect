<div class="row justify-content-center py-5">
    <div class="col-md-6">
        <div class="card card-custom p-4 shadow-lg">
            <div class="text-center mb-4">
                <div class="icon-tile icon-tile-gradient rounded-circle mx-auto mb-3" style="width: 50px; height: 50px; font-size: 1.3rem;">
                    <i class="bi bi-envelope"></i>
                </div>
                <h3 class="fw-bold">Contact Support</h3>
                <p class="text-muted small">Have questions or feedback? Send a message to the platform admins.</p>
            </div>

            <form action="/contact" method="POST">
                <div class="form-floating mb-3">
                    <input type="text" name="name" class="form-control" id="cName" placeholder="Your Name" required>
                    <label for="cName">Your Name</label>
                </div>

                <div class="form-floating mb-3">
                    <input type="email" name="email" class="form-control" id="cEmail" placeholder="Email" required>
                    <label for="cEmail">Email Address</label>
                </div>

                <div class="form-floating mb-3">
                    <input type="text" name="subject" class="form-control" id="cSubject" placeholder="Subject" required>
                    <label for="cSubject">Subject</label>
                </div>

                <div class="form-floating mb-4">
                    <textarea name="message" class="form-control" id="cMessage" style="height: 120px;" placeholder="Message" required></textarea>
                    <label for="cMessage">Your Message</label>
                </div>

                <button type="submit" class="btn btn-primary-gradient w-100 py-2">
                    Send Message <i class="bi bi-send ms-1"></i>
                </button>
            </form>
        </div>
    </div>
</div>
