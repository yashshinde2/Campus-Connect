<div class="container py-4">
    <h2 class="fw-bold mb-4">UI Component Library & Styleguide</h2>
    <p class="text-muted mb-5">Demonstrating all custom UI tokens, buttons, badges, cards, and design system components.</p>

    <!-- Buttons -->
    <div class="card card-custom p-4 mb-4">
        <h5 class="fw-bold mb-3">1. Buttons</h5>
        <div class="d-flex flex-wrap gap-3">
            <button class="btn btn-primary-gradient">Primary Gradient</button>
            <button class="btn btn-soft">Soft Tinted</button>
            <button class="btn btn-outline-primary">Outline</button>
            <button class="btn btn-danger">Danger</button>
            <button class="btn btn-success">Success</button>
        </div>
    </div>

    <!-- Category Badges -->
    <div class="card card-custom p-4 mb-4">
        <h5 class="fw-bold mb-3">2. Category Badges</h5>
        <div class="d-flex flex-wrap gap-2">
            <span class="badge badge-category badge-exam"><i class="bi bi-file-earmark-text me-1"></i> Exam</span>
            <span class="badge badge-category badge-academic"><i class="bi bi-book me-1"></i> Academic</span>
            <span class="badge badge-category badge-event"><i class="bi bi-calendar-event me-1"></i> Event</span>
            <span class="badge badge-category badge-general"><i class="bi bi-info-circle me-1"></i> General</span>
            <span class="badge badge-category badge-placement"><i class="bi bi-briefcase me-1"></i> Placement</span>
        </div>
    </div>

    <!-- Cards -->
    <div class="card card-custom p-4 mb-4">
        <h5 class="fw-bold mb-3">3. Cards & Stat Tiles</h5>
        <div class="row g-3">
            <div class="col-md-4">
                <div class="card card-custom p-3">
                    <div class="d-flex align-items-center gap-3">
                        <div class="icon-tile icon-tile-gradient">
                            <i class="bi bi-people"></i>
                        </div>
                        <div>
                            <h4 class="fw-bold mb-0">1,250</h4>
                            <small class="text-muted">Total Enrolled</small>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
